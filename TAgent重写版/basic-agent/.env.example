# Prefer the root .env.runtime generated by scripts/init_windows.ps1 or
# scripts/init_linux.sh. Never commit real values from a local .env file.
AGENT_ADMIN_TOKEN=
AGENT_INTERNAL_TOKEN=

# Service listen address.
BASIC_AGENT_HOST=127.0.0.1
BASIC_AGENT_PORT=5000

# Set to 1 to use waitress instead of Flask's development server.
USE_WAITRESS=1

# Optional HuggingFace mirror.
HF_ENDPOINT=https://hf-mirror.com

# OpenNotebook runs two processes:
#   8502 = Streamlit UI (what you open in a browser, at /notebooks)
#   5055 = REST API (what TAgent actually calls, /api/*)
# Point this at the REST API. If you paste the browser URL instead, TAgent
# rewrites 8502 -> 5055 and drops the /notebooks path for you.
OPEN_NOTEBOOK_API_URL=http://localhost:5055
# Browser URL. Only used when OPEN_NOTEBOOK_API_URL is empty.
OPEN_NOTEBOOK_URL=http://localhost:8502/notebooks
OPEN_NOTEBOOK_PASSWORD=
# KNOWLEDGE_SOURCE=local|notebook|composite
KNOWLEDGE_SOURCE=

# Optional legacy variables for the standalone pdf.py/pdf_ocr.py utilities.
# They do not register a provider for the TAgent v1 HTTP service.
OPENAI_AUTH_MODE=bearer
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
